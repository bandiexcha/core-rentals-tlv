# Inquiry form â€” email delivery (set at least one provider on Vercel)

# Option A: Gmail SMTP (for hello@corerentalstlv.com once domain is connected)
GMAIL_USER=hello@corerentalstlv.com
GMAIL_APP_PASSWORD=

# Option B: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Core Rentals TLV <onboarding@resend.dev>

# Option C: Web3Forms (https://web3forms.com â€” free, server-side friendly)
WEB3FORMS_ACCESS_KEY=

# Optional: Upstash Redis backup on Vercel (when filesystem is read-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production apartment photos (Vercel Blob) — not Git LFS
# Public origin that hosts /apartments/<slug>/… (no trailing slash)
NEXT_PUBLIC_MEDIA_BASE_URL=

# Server-only: upload token for npm run media:upload (vercel env pull)
# BLOB_READ_WRITE_TOKEN=
