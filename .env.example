# Inquiry form � email delivery (set at least one provider on Vercel)
# Canonical recipient is always SITE.inquiryEmail = avishayairbnb@gmail.com
# Do not invent @corerentals.com addresses.

# Option A: Gmail SMTP (send as the canonical Core Rentals mailbox)
GMAIL_USER=avishayairbnb@gmail.com
GMAIL_APP_PASSWORD=

# Option B: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Core Rentals TLV <onboarding@resend.dev>

# Option C: Web3Forms (https://web3forms.com � free, server-side friendly)
WEB3FORMS_ACCESS_KEY=

# Durable lead CRM (required on Vercel � filesystem is read-only)
# Classic names OR Vercel Marketplace KV injection (either pair works):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_KV_REST_API_URL=
# UPSTASH_REDIS_KV_REST_API_TOKEN=

# Operator CRM dashboard (/admin/crm) � required to unlock LIVE CRM
CRM_ADMIN_PASSWORD=

# Orchestra inbound API (/api/orchestra/*) � required to unlock LIVE Orchestra sync
ORCHESTRA_API_KEY=

# Feature flags (default on when unset; set to 0/false to disable)
# FEATURE_DURABLE_LEADS=1
# FEATURE_CRM_ADMIN=1
# FEATURE_ORCHESTRA_API=1
# FEATURE_CAMPAIGN_PAGES=1

# Production apartment photos (Vercel Blob) � not Git LFS
# Public origin that hosts /apartments/<slug>/� (no trailing slash)
NEXT_PUBLIC_MEDIA_BASE_URL=

# Server-only: upload token for npm run media:upload (vercel env pull)
# BLOB_READ_WRITE_TOKEN=

# Optional analytics (not invented � only set when real IDs exist)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=

# Customer reconnect (/admin/reconnect) � owner-only; uses CRM_ADMIN_PASSWORD
# RECONNECT_FROM_EMAIL=Avishay Ben Eli <avishayairbnb@gmail.com>
# RECONNECT_FROM_NAME=Avishay Ben Eli � Core Rentals TLV
# RECONNECT_UNSUBSCRIBE_SECRET=

# WhatsApp Cloud API (official only � coexistence with Business app)
# Do NOT set WHATSAPP_COEXISTENCE_CONFIRMED=1 until Meta Embedded Signup succeeds
# without disconnecting +972 52-759-9399 from the WhatsApp Business app.
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_RECONNECT_TEMPLATE_NAME=
# WHATSAPP_RECONNECT_TEMPLATE_LANG=en
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_COEXISTENCE_CONFIRMED=0
